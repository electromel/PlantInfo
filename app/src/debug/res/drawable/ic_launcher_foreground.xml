<?xml version="1.0" encoding="utf-8"?>
<!--
  Icône du build de test : le motif de l'application, réduit pour laisser place à un bandeau « DEV ».

  Ce fichier remplace celui de `main` uniquement pour la variante debug (source set `src/debug`) :
  l'icône publiée n'est pas touchée. Deux PlantInfo peuvent cohabiter dans le lanceur, et celle de
  test se reconnaît d'un coup d'œil.

  Le bandeau et le motif tiennent dans la zone sûre des icônes adaptatives : un masque circulaire
  rogne les coins, et un bandeau posé en diagonale dans un angle disparaîtrait.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Motif principal (viseur + feuille), réduit et remonté. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.76"
        android:scaleY="0.76"
        android:translateY="-9">
        <path
            android:pathData="M34,45 L34,34 L45,34"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M63,34 L74,34 L74,45"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M74,63 L74,74 L63,74"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M45,74 L34,74 L34,63"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M43,63 C40,50 50,41 65,41 C67,54 57,66 43,63 Z"
            android:fillColor="#A5D6A7" />
        <path
            android:pathData="M43,63 C51,58 59,51 65,41"
            android:strokeColor="#2E7D32"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
    </group>

    <!-- Bandeau « DEV » : rouge, comme le filigrane affiché dans l'application. -->
    <path
        android:pathData="M34,67 L74,67 A7,7 0 0 1 74,81 L34,81 A7,7 0 0 1 34,67 Z"
        android:fillColor="#B3261E" />
    <!-- D -->
    <path
